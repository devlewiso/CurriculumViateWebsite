---
const pillars = [
    {
        title: "IA conversacional y calidad",
        body: "Bots de Dialogflow CX y Genesys en voz, chat y WhatsApp. Los pruebo con un agente en LangGraph y mido su calidad con llamadas reales desde BigQuery.",
        d: "M12 3.5a3 3 0 0 1 3 3v.6a3 3 0 0 1 2.6 4.4 3 3 0 0 1-2.6 4.4v.6a3 3 0 0 1-6 0v-.6A3 3 0 0 1 6.4 11.5 3 3 0 0 1 9 7.1V6.5a3 3 0 0 1 3-3ZM12 8v8M9.5 10.5h5",
    },
    {
        title: "Automatización con IA",
        body: "n8n, Python y LLMs para eliminar trabajo manual: fábricas de contenido que se publican solas y, en Capgemini, 15 % menos errores en procesos fiscales.",
        d: "M10.3 4.5h3.4l.4 2.2 1.9 1.1 2.1-.9 1.7 3-1.7 1.5v2.2l1.7 1.5-1.7 3-2.1-.9-1.9 1.1-.4 2.2h-3.4l-.4-2.2-1.9-1.1-2.1.9-1.7-3L4 15.6v-2.2L2.3 11.9l1.7-3 2.1.9 1.9-1.1.3-2.2ZM12 14.4a2.4 2.4 0 1 0 0-4.8 2.4 2.4 0 0 0 0 4.8Z",
    },
    {
        title: "Producto de punta a punta",
        body: "Diseño, programo y despliego: TypeScript, React, Supabase y Vercel/Cloudflare en la nube; Docker y Proxmox en mi HomeLab.",
        d: "M6.5 18.5A3.5 3.5 0 0 1 6 11.6a5 5 0 0 1 9.6-1.4 3.9 3.9 0 0 1 .9 7.7M12 21v-7m0 0-2.2 2.2M12 14l2.2 2.2",
    },
];
---

<section id="about" class="section section--alt">
    <div class="shell about">
        <div class="about__copy">
            <p class="eyebrow reveal">Resumen profesional</p>
            <h2 class="section-title reveal" style="--reveal-delay:60ms">
                Analizo sistemas<br />y construyo los que se operan solos.
            </h2>

            <div class="about__prose reveal" style="--reveal-delay:120ms">
                <p>
                    Soy <strong>Business Systems Analyst en TELUS</strong>, bilingüe (español / inglés C1),
                    y el puente entre la operación de contact center y la ingeniería de IA. Fui
                    <strong>Tech Lead</strong> de la integración de WhatsApp con Dialogflow CX y Genesys,
                    y construí los agentes que prueban y evalúan los bots del equipo.
                </p>
                <p>
                    Fuera del trabajo construyo <strong>software propio de punta a punta</strong>:
                    Clipmill, un framework open source de video con React; Sarao, una plataforma de
                    eventos con IA en producción; y automatizaciones con n8n y LLMs que producen y
                    publican contenido solas.
                </p>
                <p>
                    Vengo del análisis financiero en Capgemini, donde empecé a automatizar con Python
                    y VBA. Hoy combino análisis de sistemas, automatización e IA para que los procesos
                    se validen, se midan y se corrijan solos.
                </p>
            </div>
        </div>

        <!-- Diagrama de arquitectura híbrida (reemplaza el placeholder anterior) -->
        <figure class="diagram card reveal" style="--reveal-delay:180ms">
            <figcaption class="diagram__cap">Cómo armo mis sistemas</figcaption>

            <div class="diagram__layer" data-tier="cloud">
                <span class="diagram__tier">IA</span>
                <div class="diagram__nodes">
                    <span class="node node--brand">LangGraph</span>
                    <span class="node node--brand">Claude / LLMs</span>
                    <span class="node node--brand">Dialogflow CX</span>
                </div>
            </div>

            <div class="diagram__link" aria-hidden="true"><span></span></div>

            <div class="diagram__layer" data-tier="orchestration">
                <span class="diagram__tier">Orquestación y apps</span>
                <div class="diagram__nodes">
                    <span class="node node--accent">n8n</span>
                    <span class="node node--accent">TypeScript</span>
                    <span class="node node--accent">Python</span>
                    <span class="node node--accent">Supabase</span>
                </div>
            </div>

            <div class="diagram__link" aria-hidden="true"><span></span></div>

            <div class="diagram__layer" data-tier="local">
                <span class="diagram__tier">Infraestructura</span>
                <div class="diagram__nodes">
                    <span class="node">Proxmox VE</span>
                    <span class="node">Docker</span>
                    <span class="node">Vercel / Cloudflare</span>
                    <span class="node">Prometheus</span>
                </div>
            </div>

            <p class="diagram__note">
                Analiza &rarr; automatiza &rarr; valida &rarr; mide &rarr; mejora
            </p>
        </figure>
    </div>

    <div class="shell about__pillars stagger">
        {pillars.map((p, i) => (
            <article class="pillar card card--hover card--lit reveal" style={`--i:${i + 1}; --reveal-delay:${i * 100}ms`}>
                <span class="pillar__icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d={p.d} />
                    </svg>
                </span>
                <h3>{p.title}</h3>
                <p>{p.body}</p>
            </article>
        ))}
    </div>
</section>

<style>
    .about {
        display: grid;
        gap: clamp(2.5rem, 6vw, 4.5rem);
        align-items: start;
    }
    @media (min-width: 980px) {
        .about { grid-template-columns: 1.05fr 0.95fr; }
    }

    .about__prose { margin-top: 1.75rem; display: grid; gap: 1.1rem; }
    .about__prose p {
        margin: 0;
        font-size: clamp(1rem, 1.6vw, 1.0625rem);
        color: var(--fg-muted);
    }
    .about__prose strong { color: var(--fg); font-weight: 600; }

    /* ---------- Diagrama ---------- */
    .diagram {
        margin: 0;
        padding: 1.5rem;
        display: grid;
        gap: 0;
        background: linear-gradient(180deg, var(--surface), var(--surface-2));
    }
    .diagram__cap {
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--fg-subtle);
        margin-bottom: 1.25rem;
    }
    .diagram__layer {
        border: 1px solid var(--line);
        border-radius: var(--r-md);
        padding: 0.9rem 1rem;
        background: var(--bg-alt);
    }
    .diagram__tier {
        display: block;
        font-family: var(--font-mono);
        font-size: 0.625rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--fg-subtle);
        margin-bottom: 0.6rem;
    }
    .diagram__nodes { display: flex; flex-wrap: wrap; gap: 0.4rem; }

    .node {
        padding: 0.28rem 0.65rem;
        border-radius: var(--r-sm);
        border: 1px solid var(--line-strong);
        background: var(--glass);
        font-size: 0.75rem;
        font-weight: 500;
        color: var(--fg-muted);
    }
    .node--brand {
        color: var(--brand-ink);
        border-color: color-mix(in srgb, var(--brand) 40%, transparent);
        background: var(--brand-soft);
    }
    .node--accent {
        color: var(--accent);
        border-color: color-mix(in srgb, var(--accent) 40%, transparent);
        background: var(--accent-soft);
    }

    .diagram__link {
        height: 1.75rem;
        display: grid;
        place-items: center;
    }
    .diagram__link span {
        display: block;
        width: 1px;
        height: 100%;
        background: linear-gradient(180deg, var(--brand), var(--accent));
        opacity: 0.55;
    }

    .diagram__note {
        margin: 1.25rem 0 0;
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        letter-spacing: 0.08em;
        text-align: center;
        color: var(--fg-subtle);
    }

    /* ---------- Pilares ---------- */
    .about__pillars {
        display: grid;
        gap: 1rem;
        margin-top: clamp(3rem, 7vw, 4.5rem);
    }
    @media (min-width: 760px) {
        .about__pillars { grid-template-columns: repeat(3, 1fr); }
    }

    .pillar { padding: 1.6rem 1.5rem; }
    .pillar__icon {
        display: grid;
        place-items: center;
        width: 2.6rem;
        height: 2.6rem;
        border-radius: var(--r-md);
        background: var(--brand-soft);
        color: var(--brand-ink);
        margin-bottom: 1.1rem;
    }
    .pillar__icon svg { width: 1.35rem; height: 1.35rem; }
    .pillar h3 {
        font-size: 1.0625rem;
        font-weight: 600;
        color: var(--fg);
        margin-bottom: 0.55rem;
    }
    .pillar p {
        margin: 0;
        font-size: 0.9375rem;
        color: var(--fg-muted);
    }
</style>
