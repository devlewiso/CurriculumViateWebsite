---
import ThemeToggle from "./ThemeToggle.astro";

const items = [
    { id: "home",       label: "Inicio",     title: "Inicio",
      d: "M3.5 10.5 12 3.5l8.5 7M5.5 9.5V20h13V9.5" },
    { id: "about",      label: "Perfil",     title: "Resumen profesional",
      d: "M12 12a3.75 3.75 0 1 0 0-7.5 3.75 3.75 0 0 0 0 7.5ZM4.5 20a7.5 7.5 0 0 1 15 0" },
    { id: "experience", label: "Trayectoria", title: "Experiencia profesional",
      d: "M4 8h16v11a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V8ZM9 8V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5V8M4 13h16" },
    { id: "projects",   label: "Proyectos",  title: "Proyectos y automatizaciones",
      d: "M9.5 20 14.5 4M18 8.5 21.5 12 18 15.5M6 15.5 2.5 12 6 8.5" },
    { id: "skills",     label: "Stack",      title: "Stack técnico y certificaciones",
      d: "M12 3.5 20 8v8l-8 4.5L4 16V8l8-4.5ZM4 8l8 4.5M20 8l-8 4.5M12 12.5V20.5" },
    { id: "contact",    label: "Contacto",   title: "Contacto",
      d: "M3.5 7.5 12 13l8.5-5.5M4.5 5.5h15a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1h-15a1 1 0 0 1-1-1v-11a1 1 0 0 1 1-1Z" },
];
const CV_URL = "https://drive.google.com/file/d/1Sb5StgzBUO3deQbTH78lIwBIMB0w7Ucp/view?usp=drive_link";
---

<!-- ============ NAVBAR SUPERIOR (sticky, todos los tamaños) ============ -->
<header id="topnav" class="topnav" aria-label="Navegación principal">
    <div class="shell topnav__inner">
        <a href="#home" class="topnav__brand" aria-label="Iran Lewis Ortiz — inicio">
            <span class="topnav__mark">ILO</span>
            <span class="topnav__name">Iran Lewis Ortiz</span>
        </a>

        <nav class="topnav__links" aria-label="Secciones">
            {items.map((it) => (
                <a href={`#${it.id}`} class="topnav__link" data-nav={it.id} title={it.title}>
                    {it.label}
                </a>
            ))}
        </nav>

        <div class="topnav__actions">
            <a href={CV_URL} target="_blank" rel="noopener noreferrer" class="topnav__cv" title="Descargar CV en PDF">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 4v10m0 0-3.5-3.5M12 14l3.5-3.5M5 17.5v1A1.5 1.5 0 0 0 6.5 20h11a1.5 1.5 0 0 0 1.5-1.5v-1" />
                </svg>
                <span>CV</span>
            </a>
            <a href="#contact" class="btn btn--primary topnav__hire">Contratar</a>
            <ThemeToggle />
        </div>
    </div>
</header>

<!-- ============ MOBILE TAB BAR ============ -->
<nav id="tabbar" class="tabbar glass" aria-label="Navegación principal (móvil)">
    {items.map((it) => (
        <a href={`#${it.id}`} class="tabbar__item" data-nav={it.id} aria-label={it.title}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={it.d} />
            </svg>
            <span>{it.label}</span>
        </a>
    ))}
</nav>

<style>
    /* ---------------- Navbar superior ---------------- */
    .topnav {
        position: sticky;
        top: 0;
        z-index: 70;
        background: var(--glass);
        backdrop-filter: blur(16px) saturate(140%);
        -webkit-backdrop-filter: blur(16px) saturate(140%);
        border-bottom: 1px solid var(--line);
    }

    .topnav__inner {
        display: flex;
        align-items: center;
        gap: 1rem;
        height: var(--nav-h);
    }

    .topnav__brand {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        text-decoration: none;
        flex: none;
    }
    .topnav__mark {
        display: grid;
        place-items: center;
        width: 2.35rem;
        height: 2.35rem;
        border-radius: var(--r-md);
        background: linear-gradient(135deg, var(--v-600), var(--c-500));
        color: #fff;
        font-family: var(--font-display);
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.03em;
        box-shadow: 0 6px 18px -8px rgba(124, 92, 255, 0.9);
        transition: transform var(--dur-base) var(--ease-out),
                    box-shadow var(--dur-base) var(--ease-out);
    }
    .topnav__brand:hover .topnav__mark {
        transform: translateY(-2px) rotate(-3deg);
        box-shadow: 0 10px 26px -8px rgba(124, 92, 255, 1);
    }
    .topnav__name {
        display: none;
        font-family: var(--font-display);
        font-size: 0.9375rem;
        font-weight: 600;
        color: var(--fg);
        white-space: nowrap;
    }
    @media (min-width: 1100px) { .topnav__name { display: block; } }

    /* Links: sólo desktop — en mobile la navegación vive en el tab bar inferior */
    .topnav__links {
        display: none;
        align-items: center;
        gap: 0.25rem;
        margin-inline: auto;
    }
    @media (min-width: 900px) {
        .topnav__links { display: flex; }
    }

    .topnav__link {
        position: relative;
        padding: 0.5rem 0.85rem;
        border-radius: var(--r-sm);
        color: var(--fg-muted);
        font-size: 0.875rem;
        font-weight: 500;
        text-decoration: none;
        white-space: nowrap;
        transition: color var(--dur-base) var(--ease-out);
    }
    .topnav__link::after {
        content: "";
        position: absolute;
        left: 0.85rem;
        right: 0.85rem;
        bottom: 0.2rem;
        height: 2px;
        border-radius: var(--r-pill);
        background: linear-gradient(90deg, var(--v-600), var(--c-400));
        scale: 0 1;
        transform-origin: 0 50%;
        transition: scale var(--dur-base) var(--ease-out);
    }
    .topnav__link:hover { color: var(--fg); }
    .topnav__link:hover::after { scale: 0.5 1; }
    .topnav__link.is-active { color: var(--fg); }
    .topnav__link.is-active::after { scale: 1 1; }

    /* Acciones: CV + Hire sólo desktop (en mobile viven en el contenido: Hero/Contacto) */
    .topnav__actions {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        flex: none;
        margin-left: auto;
    }

    .topnav__cv {
        display: none;
        align-items: center;
        gap: 0.4rem;
        padding: 0.5rem 0.75rem;
        border-radius: var(--r-pill);
        border: 1px solid var(--line-strong);
        color: var(--fg-muted);
        font-size: 0.8125rem;
        font-weight: 600;
        text-decoration: none;
        transition: color var(--dur-base) var(--ease-out),
                    border-color var(--dur-base) var(--ease-out),
                    background var(--dur-base) var(--ease-out);
    }
    .topnav__cv svg { width: 1rem; height: 1rem; }
    .topnav__cv:hover { color: var(--fg); border-color: var(--brand); background: var(--brand-soft); }
    @media (min-width: 900px) { .topnav__cv { display: inline-flex; } }

    .topnav__hire {
        display: none;
        min-height: 2.35rem;
        padding: 0.5rem 1rem;
        font-size: 0.8125rem;
    }
    @media (min-width: 900px) { .topnav__hire { display: inline-flex; } }

    /* ---------------- Mobile tab bar ---------------- */
    .tabbar {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 60;
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        border-top: 1px solid var(--line);
        border-inline: none;
        border-bottom: none;
        padding-bottom: env(safe-area-inset-bottom, 0px);
    }
    @media (min-width: 900px) { .tabbar { display: none; } }

    .tabbar__item {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.2rem;
        min-height: 3.5rem;           /* ≥44px touch target */
        padding-block: 0.5rem;
        color: var(--fg-subtle);
        text-decoration: none;
        transition: color var(--dur-fast) var(--ease-out);
    }
    .tabbar__item svg { width: 1.25rem; height: 1.25rem; }
    .tabbar__item span {
        max-width: 100%;
        padding-inline: 0.15rem;
        font-size: 0.5625rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    /* Pantallas muy angostas (≤340px): el ícono basta, la etiqueta se achica */
    @media (max-width: 340px) {
        .tabbar__item span { font-size: 0.5rem; letter-spacing: 0; }
    }
    .tabbar__item.is-active { color: var(--accent); }
</style>
