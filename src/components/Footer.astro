---
const year = new Date().getFullYear();
---

<footer class="foot">
    <div class="shell foot__inner">
        <p class="foot__copy">© {year} Iran Lewis Ortiz · Arquitectura tecnológica</p>
        <p class="foot__built">
            Construido con
            <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>
            &amp; scroll-driven CSS
        </p>
        <a href="#home" class="foot__top">
            Volver al inicio
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 19V5m0 0-5.5 5.5M12 5l5.5 5.5" />
            </svg>
        </a>
    </div>
</footer>

<style>
    .foot {
        border-top: 1px solid var(--line);
        background: var(--bg);
        padding-block: 2.25rem;
    }
    .foot__inner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        font-size: 0.8125rem;
        color: var(--fg-subtle);
    }
    .foot p { margin: 0; }
    .foot a {
        color: var(--fg-muted);
        text-decoration: none;
        transition: color var(--dur-fast) var(--ease-out);
    }
    .foot a:hover { color: var(--accent); }
    .foot__top { display: inline-flex; align-items: center; gap: 0.4rem; }
    .foot__top svg { width: 0.9rem; height: 0.9rem; }
</style>
