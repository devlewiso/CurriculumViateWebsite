---
const roles = [
    {
        period: "Mar 2023 — Presente",
        current: true,
        title: "Tax Analyst / Portfolio Specialist & VDI Tester",
        org: "Capgemini · División BPO Financiero",
        place: "Guatemala / Remoto",
        bullets: [
            "Revisión de certificados de exención de impuestos de EE. UU. asegurando el cumplimiento normativo.",
            "Lideré proyectos de estandarización de procesos que redujeron errores manuales en un 15%.",
            "Desarrollo de scripts de automatización con Python, Excel VBA y Google Workspace.",
            "Testing funcional en entornos VDI Windows 11 Citrix, validando rendimiento y flujos de automatización.",
        ],
        tags: ["Python", "Excel VBA", "Google Workspace", "VDI / Citrix"],
    },
    {
        period: "Jul 2022 — Feb 2023",
        current: false,
        title: "Collections Analyst",
        org: "Capgemini · División BPO Financiero",
        place: "Guatemala / Remoto",
        bullets: [
            "Gestión de cobros para clientes financieros, superando consistentemente los objetivos mensuales de recuperación.",
            "Diseño y documentación de estrategias de mejora de procesos basadas en análisis de KPI.",
            "Aseguramiento del cumplimiento de normativas internas y externas.",
        ],
        tags: ["Análisis de KPI", "Compliance", "Mejora de procesos"],
    },
    {
        period: "Esperado 2025",
        current: false,
        title: "Licenciatura en Tecnología y Administración de Telecomunicaciones",
        org: "Universidad Galileo",
        place: "Guatemala",
        bullets: [],
        tags: [],
        education: true,
    },
];
---

<section id="experience" class="section">
    <div class="shell">
        <header class="xp__head">
            <p class="eyebrow reveal">Trayectoria</p>
            <h2 class="section-title reveal" style="--reveal-delay:60ms">Experiencia profesional</h2>
            <p class="section-lede reveal" style="--reveal-delay:120ms">
                Del análisis financiero a la arquitectura de sistemas: cada rol añadió una capa
                de automatización sobre procesos que antes eran manuales.
            </p>
        </header>

        <ol class="xp">
            <!-- Columna de la línea de tiempo: se dibuja con el scroll -->
            <div class="xp__spine" aria-hidden="true">
                <span class="xp__spine-track"></span>
                <span class="xp__spine-fill spine-fill"></span>
            </div>

            {roles.map((r, i) => (
                <li class={`xp__item reveal ${r.education ? "xp__item--edu" : ""}`} style={`--reveal-delay:${i * 110}ms`}>
                    <span class={`xp__dot ${r.current ? "xp__dot--live" : ""}`} aria-hidden="true"></span>

                    <div class="xp__meta">
                        <time class="xp__period">{r.period}</time>
                        {r.current && <span class="xp__now">Actual</span>}
                    </div>

                    <div class="xp__body">
                        <h3 class="xp__title">{r.title}</h3>
                        <p class="xp__org">
                            <span>{r.org}</span>
                            <span class="xp__sep" aria-hidden="true">·</span>
                            <span class="xp__place">{r.place}</span>
                        </p>

                        {r.bullets.length > 0 && (
                            <ul class="xp__bullets">
                                {r.bullets.map((b) => (
                                    <li>
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M5 12.5 10 17 19 7.5" />
                                        </svg>
                                        <span>{b}</span>
                                    </li>
                                ))}
                            </ul>
                        )}

                        {r.tags.length > 0 && (
                            <ul class="xp__tags">
                                {r.tags.map((t) => <li class="chip">{t}</li>)}
                            </ul>
                        )}
                    </div>
                </li>
            ))}
        </ol>
    </div>
</section>

<style>
    .xp__head { max-width: 46rem; margin-bottom: clamp(3rem, 7vw, 4.5rem); }

    .xp {
        position: relative;
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: clamp(2.5rem, 5vw, 3.5rem);
        view-timeline-name: --xp;
        view-timeline-axis: block;
    }

    /* --- Spine --- */
    .xp__spine {
        position: absolute;
        top: 0.55rem;
        bottom: 2rem;
        left: 0.4375rem;               /* centro del dot (14px / 2) */
        width: 1px;
    }
    @media (min-width: 880px) {
        .xp__spine { left: calc(11rem + 0.4375rem); }
    }
    .xp__spine-track,
    .xp__spine-fill {
        position: absolute;
        inset: 0;
        width: 1px;
        border-radius: var(--r-pill);
    }
    .xp__spine-track { background: var(--line); }
    .xp__spine-fill {
        background: linear-gradient(180deg, var(--v-600), var(--c-400));
        box-shadow: 0 0 10px color-mix(in srgb, var(--brand) 60%, transparent);
    }

    /* --- Item --- */
    .xp__item {
        position: relative;
        display: grid;
        gap: 0.75rem;
        padding-left: 2.25rem;
    }
    @media (min-width: 880px) {
        .xp__item {
            grid-template-columns: 11rem 1fr;
            gap: 0 3rem;
            padding-left: 0;
        }
    }

    .xp__dot {
        position: absolute;
        top: 0.5rem;
        left: 0;
        width: 0.875rem;
        height: 0.875rem;
        border-radius: 50%;
        background: var(--bg);
        border: 2px solid var(--line-strong);
        z-index: 1;
        transition: border-color var(--dur-base) var(--ease-out),
                    box-shadow var(--dur-base) var(--ease-out);
    }
    @media (min-width: 880px) { .xp__dot { left: 11rem; } }

    .xp__item:hover .xp__dot { border-color: var(--accent); }
    .xp__dot--live {
        border-color: var(--accent);
        background: var(--accent);
        box-shadow: 0 0 0 4px var(--accent-soft);
    }

    .xp__meta {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        flex-wrap: wrap;
    }
    @media (min-width: 880px) {
        .xp__meta { justify-content: flex-end; padding-top: 0.1rem; }
    }
    .xp__period {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.06em;
        color: var(--fg-subtle);
        white-space: nowrap;
    }
    .xp__now {
        padding: 0.15rem 0.5rem;
        border-radius: var(--r-pill);
        background: var(--accent-soft);
        border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
        color: var(--accent);
        font-family: var(--font-mono);
        font-size: 0.625rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .xp__title {
        font-size: clamp(1.125rem, 2.2vw, 1.375rem);
        font-weight: 600;
        color: var(--fg);
    }
    .xp__org {
        margin: 0.4rem 0 0;
        font-size: 0.9375rem;
        color: var(--fg-muted);
    }
    .xp__sep { margin-inline: 0.45rem; color: var(--fg-subtle); }
    .xp__place { color: var(--fg-subtle); }

    .xp__bullets {
        list-style: none;
        margin: 1.1rem 0 0;
        padding: 0;
        display: grid;
        gap: 0.65rem;
    }
    .xp__bullets li {
        display: grid;
        grid-template-columns: 1.1rem 1fr;
        gap: 0.7rem;
        align-items: start;
        font-size: 0.9375rem;
        color: var(--fg-muted);
    }
    .xp__bullets svg {
        width: 1.1rem;
        height: 1.1rem;
        margin-top: 0.3rem;
        color: var(--accent);
    }

    .xp__tags {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin: 1.1rem 0 0;
        padding: 0;
    }

    .xp__item--edu .xp__body { opacity: 0.92; }
</style>
