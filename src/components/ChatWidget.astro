---
// ChatWidget.astro — asistente conectado al webhook n8n
---

<div class="chat">
    <button
        class="chat__fab"
        id="chatBtn"
        type="button"
        aria-label="Abrir asistente"
        aria-expanded="false"
        aria-controls="chatBox"
    >
        <svg class="chat__fab-ico chat__fab-ico--open" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3.5a8.5 8.5 0 0 1 0 17H4l2.1-2.9A8.5 8.5 0 0 1 12 3.5Z" />
            <path d="M8.8 12h.01M12 12h.01M15.2 12h.01" />
        </svg>
        <svg class="chat__fab-ico chat__fab-ico--close" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true">
            <path d="M6 6l12 12M18 6 6 18" />
        </svg>
    </button>

    <div class="chat__panel card" id="chatBox" role="dialog" aria-label="Asistente de Iran Lewis Ortiz">
        <header class="chat__head">
            <span class="chat__avatar" aria-hidden="true">ILO</span>
            <span class="chat__id">
                <strong>Asistente</strong>
                <span class="chat__status"><i aria-hidden="true"></i> En línea</span>
            </span>
            <button id="closeBtn" type="button" class="chat__close" aria-label="Cerrar asistente">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                     stroke-linecap="round" aria-hidden="true">
                    <path d="M6 6l12 12M18 6 6 18" />
                </svg>
            </button>
        </header>

        <div class="chat__log" id="messages" role="log" aria-live="polite" aria-atomic="false">
            <div class="msg msg--bot">
                Hola, soy el asistente de Iran. Pregúntame sobre su experiencia,
                stack o proyectos de automatización.
            </div>
        </div>

        <form class="chat__form" id="chatForm">
            <label class="sr-only" for="input">Escribe tu mensaje</label>
            <input
                type="text"
                id="input"
                name="message"
                placeholder="Escribe tu pregunta…"
                autocomplete="off"
            />
            <button type="submit" id="sendBtn" aria-label="Enviar mensaje">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M4.5 12h13M12 5.5 18.5 12 12 18.5" />
                </svg>
            </button>
        </form>
    </div>
</div>

<style>
    .chat {
        position: fixed;
        right: 1.25rem;
        bottom: calc(4.75rem + env(safe-area-inset-bottom, 0px));
        z-index: 80;
    }
    @media (min-width: 900px) { .chat { right: 1.75rem; bottom: 1.75rem; } }

    /* ---------- FAB ---------- */
    .chat__fab {
        display: grid;
        place-items: center;
        width: 3.25rem;
        height: 3.25rem;
        border: none;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--v-600), var(--c-500));
        color: #fff;
        cursor: pointer;
        box-shadow: 0 8px 24px -8px rgba(124, 92, 255, 0.85);
        transition: transform var(--dur-base) var(--ease-out),
                    box-shadow var(--dur-base) var(--ease-out);
    }
    .chat__fab:hover {
        transform: translateY(-2px) scale(1.04);
        box-shadow: 0 12px 32px -8px rgba(124, 92, 255, 1);
    }
    .chat__fab-ico { width: 1.4rem; height: 1.4rem; grid-area: 1 / 1; }
    .chat__fab-ico--close { opacity: 0; scale: 0.6; transition: opacity var(--dur-fast), scale var(--dur-fast); }
    .chat__fab-ico--open  { opacity: 1; scale: 1;   transition: opacity var(--dur-fast), scale var(--dur-fast); }
    .chat.is-open .chat__fab-ico--close { opacity: 1; scale: 1; }
    .chat.is-open .chat__fab-ico--open  { opacity: 0; scale: 0.6; }

    /* ---------- Panel ---------- */
    .chat__panel {
        position: absolute;
        right: 0;
        bottom: 4rem;
        width: min(22rem, calc(100vw - 2.5rem));
        height: min(30rem, calc(100svh - 10rem));
        display: flex;
        flex-direction: column;
        overflow: hidden;
        background: var(--surface);
        border: 1px solid var(--line-strong);
        border-radius: var(--r-lg);
        box-shadow: var(--shadow-lg);
        opacity: 0;
        translate: 0 0.75rem;
        scale: 0.97;
        transform-origin: 100% 100%;
        pointer-events: none;
        transition: opacity var(--dur-base) var(--ease-out),
                    translate var(--dur-base) var(--ease-out),
                    scale var(--dur-base) var(--ease-out);
    }
    .chat.is-open .chat__panel {
        opacity: 1;
        translate: 0 0;
        scale: 1;
        pointer-events: auto;
    }

    .chat__head {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        padding: 0.85rem 0.9rem;
        border-bottom: 1px solid var(--line);
        background: var(--surface-2);
    }
    .chat__avatar {
        display: grid;
        place-items: center;
        width: 2rem;
        height: 2rem;
        border-radius: var(--r-sm);
        background: linear-gradient(135deg, var(--v-600), var(--c-500));
        color: #fff;
        font-family: var(--font-display);
        font-size: 0.625rem;
        font-weight: 700;
        flex: none;
    }
    .chat__id { display: grid; gap: 0.05rem; flex: 1; min-width: 0; }
    .chat__id strong { font-size: 0.8125rem; font-weight: 600; color: var(--fg); }
    .chat__status {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-family: var(--font-mono);
        font-size: 0.625rem;
        color: var(--fg-subtle);
    }
    .chat__status i {
        width: 0.35rem;
        height: 0.35rem;
        border-radius: 50%;
        background: var(--accent);
    }
    .chat__close {
        display: grid;
        place-items: center;
        width: 1.9rem;
        height: 1.9rem;
        border: none;
        border-radius: var(--r-sm);
        background: transparent;
        color: var(--fg-subtle);
        cursor: pointer;
        transition: background var(--dur-fast), color var(--dur-fast);
    }
    .chat__close:hover { background: var(--glass-hover); color: var(--fg); }
    .chat__close svg { width: 1rem; height: 1rem; }

    /* ---------- Log ---------- */
    .chat__log {
        flex: 1;
        overflow-y: auto;
        overscroll-behavior: contain;
        padding: 1rem 0.9rem;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }
    .msg {
        max-width: 85%;
        padding: 0.6rem 0.8rem;
        border-radius: var(--r-md);
        font-size: 0.875rem;
        line-height: 1.5;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        animation: msg-in 260ms var(--ease-out) both;
    }
    @keyframes msg-in {
        from { opacity: 0; transform: translateY(6px); }
        to   { opacity: 1; transform: none; }
    }
    .msg--bot {
        align-self: flex-start;
        background: var(--surface-2);
        border: 1px solid var(--line);
        color: var(--fg);
        border-bottom-left-radius: var(--r-sm);
    }
    .msg--user {
        align-self: flex-end;
        background: linear-gradient(135deg, var(--v-600), var(--v-500));
        color: #fff;
        border-bottom-right-radius: var(--r-sm);
    }
    .msg--error {
        align-self: flex-start;
        background: color-mix(in srgb, #dc2626 12%, transparent);
        border: 1px solid color-mix(in srgb, #dc2626 35%, transparent);
        color: #fca5a5;
    }

    /* Indicador de escritura (3 puntos) */
    .msg--typing { display: inline-flex; gap: 0.25rem; align-items: center; padding: 0.75rem 0.85rem; }
    .msg--typing span {
        width: 0.35rem;
        height: 0.35rem;
        border-radius: 50%;
        background: var(--fg-subtle);
        animation: typing 1.2s var(--ease-io) infinite;
    }
    .msg--typing span:nth-child(2) { animation-delay: 0.15s; }
    .msg--typing span:nth-child(3) { animation-delay: 0.3s; }
    @keyframes typing {
        0%, 60%, 100% { opacity: 0.3; transform: translateY(0); }
        30%           { opacity: 1;   transform: translateY(-3px); }
    }

    /* ---------- Form ---------- */
    .chat__form {
        display: flex;
        gap: 0.5rem;
        padding: 0.75rem;
        border-top: 1px solid var(--line);
        background: var(--surface-2);
    }
    .chat__form input {
        flex: 1;
        min-width: 0;
        min-height: 2.5rem;
        padding: 0.5rem 0.75rem;
        border-radius: var(--r-sm);
        border: 1px solid var(--line-strong);
        background: var(--bg);
        color: var(--fg);
        font-family: inherit;
        font-size: 0.875rem;
        outline: none;
        transition: border-color var(--dur-fast) var(--ease-out);
    }
    .chat__form input::placeholder { color: var(--fg-subtle); }
    .chat__form input:focus { border-color: var(--brand); }
    .chat__form button {
        display: grid;
        place-items: center;
        width: 2.5rem;
        height: 2.5rem;
        flex: none;
        border: none;
        border-radius: var(--r-sm);
        background: linear-gradient(135deg, var(--v-600), var(--c-500));
        color: #fff;
        cursor: pointer;
        transition: transform var(--dur-fast) var(--ease-out), opacity var(--dur-fast);
    }
    .chat__form button:hover:not(:disabled) { transform: translateY(-1px); }
    .chat__form button:disabled { opacity: 0.5; cursor: not-allowed; }
    .chat__form button svg { width: 1.05rem; height: 1.05rem; }

    .sr-only {
        position: absolute;
        width: 1px; height: 1px;
        padding: 0; margin: -1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
        border: 0;
    }

    @media (prefers-reduced-motion: reduce) {
        .msg { animation: none; }
        .msg--typing span { animation: none; opacity: 0.6; }
        .chat__panel { transition: opacity 0.01ms; }
    }
</style>

<script>
    const WEBHOOK_URL = "https://trigger.nosotros.space/webhook/mycv";
    const CHAT_ID = crypto?.randomUUID?.() || `chat-${Date.now()}`;

    const wrap = document.querySelector<HTMLElement>(".chat");
    const chatBtn = document.getElementById("chatBtn");
    const closeBtn = document.getElementById("closeBtn");
    const form = document.getElementById("chatForm") as HTMLFormElement | null;
    const input = document.getElementById("input") as HTMLInputElement | null;
    const sendBtn = document.getElementById("sendBtn") as HTMLButtonElement | null;
    const log = document.getElementById("messages");

    const setOpen = (open: boolean) => {
        wrap?.classList.toggle("is-open", open);
        chatBtn?.setAttribute("aria-expanded", String(open));
        if (open) input?.focus();
    };

    chatBtn?.addEventListener("click", () =>
        setOpen(!wrap?.classList.contains("is-open")),
    );
    closeBtn?.addEventListener("click", () => {
        setOpen(false);
        chatBtn?.focus();
    });
    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && wrap?.classList.contains("is-open")) {
            setOpen(false);
            chatBtn?.focus();
        }
    });

    function addMsg(text: string, kind: "user" | "bot" | "error") {
        const el = document.createElement("div");
        el.className = `msg msg--${kind}`;
        el.textContent = text;
        log?.appendChild(el);
        if (log) log.scrollTop = log.scrollHeight;
        return el;
    }

    function addTyping() {
        const el = document.createElement("div");
        el.className = "msg msg--bot msg--typing";
        el.innerHTML = "<span></span><span></span><span></span>";
        el.setAttribute("aria-label", "Escribiendo…");
        log?.appendChild(el);
        if (log) log.scrollTop = log.scrollHeight;
        return el;
    }

    form?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const text = input?.value.trim();
        if (!text) return;

        addMsg(text, "user");
        input!.value = "";
        if (sendBtn) sendBtn.disabled = true;
        const typing = addTyping();

        try {
            const res = await fetch(WEBHOOK_URL, {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: new URLSearchParams({ message: text, chat_id: CHAT_ID }),
            });

            typing.remove();

            if (!res.ok) {
                addMsg("El asistente no está disponible en este momento.", "error");
                return;
            }

            const data = await res.text();
            let reply = data || "Sin respuesta";
            try {
                const json = JSON.parse(data);
                reply = json.output || json.message || data;
            } catch {
                /* la respuesta no es JSON: se usa el texto tal cual */
            }
            addMsg(String(reply).replace(/\\n/g, "\n"), "bot");
        } catch {
            typing.remove();
            addMsg("Error de conexión. Intenta de nuevo.", "error");
        } finally {
            if (sendBtn) sendBtn.disabled = false;
            input?.focus();
        }
    });
</script>
