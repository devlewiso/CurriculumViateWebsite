---
const featured = {
    title: "HomeLab Infrastructure",
    kicker: "Proyecto principal",
    body: "Infraestructura completa self-hosted sobre Proxmox VE con una VM de CasaOS que orquesta múltiples servicios en contenedores Docker. Diseñada para alta disponibilidad, auto-recuperación y gestión centralizada.",
    groups: [
        { label: "Virtualización", items: ["Proxmox VE", "CasaOS", "Docker"] },
        { label: "Media", items: ["Plex", "Sonarr", "Radarr", "Overseerr", "Prowlarr"] },
        { label: "Operación", items: ["Home Assistant", "Prometheus", "Omada Controller", "NVR", "Open WebUI"] },
    ],
};

const solutions = [
    {
        title: "ChatOps Orchestrator",
        body: "Puente de comunicación automatizado para coordinar incidentes y alertas en tiempo real. Sincroniza respuestas de servicios cloud con la infraestructura local para remediación inmediata.",
        tools: ["Slack", "Twilio", "Dialogflow CX", "HomeLab"],
        d: "M8 10.5h8M8 14h5M5.5 4.5h13a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H12l-4.5 4v-4H5.5a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1Z",
    },
    {
        title: "Self-Healing Infrastructure Agent",
        body: "Monitoreo autónomo que detecta caídas de servicio, activa acciones de recuperación, verifica la restauración y registra resultados. Desplegado con éxito en HomeLab y Cloud.",
        tools: ["n8n", "Docker", "Home Assistant", "AI Decision Logic"],
        d: "M12 20.5a8.5 8.5 0 1 0-8.5-8.5M3.5 12V7.5M3.5 12H8M12 7.5v5l3.2 1.9",
    },
    {
        title: "Omnichannel AI Assistant",
        body: "Bot conversacional desplegado en múltiples canales. Integra Dialogflow CX para gestión de intenciones con un panel de análisis en Google Cloud para medir rendimiento y precisión.",
        tools: ["Dialogflow CX", "WhatsApp", "Telegram", "Messenger", "Google Cloud"],
        d: "M12 3.5a8.5 8.5 0 0 1 0 17H4l2.1-2.9A8.5 8.5 0 0 1 12 3.5ZM8.8 12h.01M12 12h.01M15.2 12h.01",
    },
];
---

<section id="projects" class="section section--alt">
    <div class="shell">
        <header class="pj__head">
            <p class="eyebrow reveal">Trabajo</p>
            <h2 class="section-title reveal" style="--reveal-delay:60ms">Proyectos &amp; automatizaciones</h2>
            <p class="section-lede reveal" style="--reveal-delay:120ms">
                Lo que corre hoy en producción, y lo que puedo diseñar e implementar para tu organización.
            </p>
        </header>

        <!-- Portada conceptual (arte generativo, FLUX.1-schnell vía Space gratuito de Hugging Face) -->
        <figure class="pj__cover reveal" tabindex="0" aria-label="Ilustración conceptual generada por IA de la infraestructura HomeLab">
            <img
                src="/images/homelab-surreal.webp"
                alt="Ilustración surrealista generada por IA: un árbol de servidores fusionado con circuitos bioluminiscentes, representando la infraestructura HomeLab de forma conceptual"
                width="1100" height="629" loading="lazy"
            />
            <figcaption>
                <span>Visión conceptual — arte generativo, no captura real de la infraestructura</span>
                <span class="pj__cover-badge">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 3.5 14.6 9l6 .9-4.3 4.2 1 6-5.3-2.8-5.3 2.8 1-6L3.4 9.9 9.4 9 12 3.5Z" />
                    </svg>
                    IA generativa
                </span>
            </figcaption>
        </figure>

        <!-- Proyecto destacado -->
        <article class="feat card card--lit reveal">
            <div class="feat__main">
                <p class="feat__kicker">
                    <span class="dot-live" aria-hidden="true"></span>
                    {featured.kicker}
                </p>
                <h3 class="feat__title">{featured.title}</h3>
                <p class="feat__body">{featured.body}</p>

                <div class="feat__groups">
                    {featured.groups.map((g) => (
                        <div class="feat__group">
                            <p class="feat__group-label">{g.label}</p>
                            <ul>
                                {g.items.map((it) => <li class="chip">{it}</li>)}
                            </ul>
                        </div>
                    ))}
                </div>
            </div>

            <!-- Visual: rack de servicios -->
            <div class="rack" aria-hidden="true">
                <div class="rack__head">
                    <span class="rack__led"></span>
                    <span class="rack__name">proxmox-ve · node01</span>
                </div>
                {[
                    ["casaos-vm", "running", 94],
                    ["docker-stack", "running", 71],
                    ["home-assistant", "running", 38],
                    ["prometheus", "running", 52],
                    ["plex-media", "running", 83],
                    ["omada-ctrl", "running", 26],
                ].map(([name, state, load], i) => (
                    <div class="rack__row" style={`--i:${i}`}>
                        <span class="rack__svc">{name}</span>
                        <span class="rack__bar"><span style={`width:${load}%`}></span></span>
                        <span class="rack__state">{state}</span>
                    </div>
                ))}
            </div>
        </article>

        <!-- Soluciones -->
        <h3 class="pj__subhead reveal">Automatizaciones que podemos construir</h3>

        <div class="pj__grid stagger">
            {solutions.map((s, i) => (
                <article class="sol card card--hover card--lit reveal" style={`--i:${i + 1}; --reveal-delay:${i * 100}ms`}>
                    <span class="sol__icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d={s.d} />
                        </svg>
                    </span>
                    <h4>{s.title}</h4>
                    <p>{s.body}</p>
                    <ul class="sol__tools">
                        {s.tools.map((t) => <li class="chip chip--accent">{t}</li>)}
                    </ul>
                </article>
            ))}
        </div>
    </div>
</section>

<style>
    .pj__head { max-width: 46rem; margin-bottom: clamp(2.5rem, 6vw, 3.5rem); }

    /* ---------- Portada conceptual ---------- */
    .pj__cover {
        position: relative;
        margin: 0 0 1rem;
        border-radius: var(--r-xl);
        overflow: hidden;
        border: 1px solid var(--line);
        box-shadow: var(--shadow-md);
        transition: border-color var(--dur-base) var(--ease-out),
                    box-shadow var(--dur-base) var(--ease-out);
    }
    .pj__cover:hover,
    .pj__cover:focus-within {
        border-color: var(--line-strong);
        box-shadow: var(--shadow-lg);
    }

    /* Hairline de degradado que enciende el borde superior, igual que .card--lit */
    .pj__cover::before {
        content: "";
        position: absolute;
        inset: -1px -1px auto -1px;
        height: 1px;
        z-index: 2;
        border-radius: inherit;
        background: linear-gradient(90deg, transparent, var(--brand), var(--accent), transparent);
        opacity: 0;
        transition: opacity var(--dur-base) var(--ease-out);
    }
    .pj__cover:hover::before,
    .pj__cover:focus-within::before { opacity: 0.9; }

    .pj__cover img {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 1100 / 629;
        object-fit: cover;
        scale: 1;
        filter: saturate(1);
        transition: scale 900ms var(--ease-out), filter 900ms var(--ease-out);
    }
    .pj__cover:hover img,
    .pj__cover:focus-within img { scale: 1.045; filter: saturate(1.15); }

    .pj__cover figcaption {
        position: absolute;
        inset: auto 0 0 0;
        z-index: 1;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1rem;
        padding: 2.75rem 1.25rem 0.9rem;
        background: linear-gradient(0deg, rgba(8,7,15,.88) 0%, transparent 100%);
        color: #cbd5e1;
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        letter-spacing: 0.04em;
        transition: color var(--dur-base) var(--ease-out);
    }
    .pj__cover:hover figcaption,
    .pj__cover:focus-within figcaption { color: #f1f5f9; }

    .pj__cover-badge {
        flex: none;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.25rem 0.6rem;
        border-radius: var(--r-pill);
        border: 1px solid rgba(255,255,255,.18);
        background: rgba(255,255,255,.08);
        backdrop-filter: blur(6px);
        color: #e9e7f3;
        font-size: 0.625rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        opacity: 0;
        translate: 0 4px;
        transition: opacity var(--dur-base) var(--ease-out), translate var(--dur-base) var(--ease-out);
    }
    .pj__cover-badge svg { width: 0.8rem; height: 0.8rem; }
    .pj__cover:hover .pj__cover-badge,
    .pj__cover:focus-within .pj__cover-badge { opacity: 1; translate: 0 0; }

    /* ---------- Destacado ---------- */
    .feat {
        display: grid;
        gap: clamp(2rem, 4vw, 3rem);
        padding: clamp(1.5rem, 3.5vw, 2.5rem);
        background: linear-gradient(145deg, var(--surface), var(--surface-2));
        view-timeline-name: --feat;
        view-timeline-axis: block;
    }
    @media (min-width: 1000px) {
        .feat { grid-template-columns: 1.15fr 0.85fr; align-items: center; }
    }

    .feat__kicker {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        margin: 0 0 1rem;
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--accent);
    }
    .dot-live {
        width: 0.45rem;
        height: 0.45rem;
        border-radius: 50%;
        background: currentColor;
        animation: pulse-dot 2.4s var(--ease-out) infinite;
    }

    .feat__title {
        font-size: clamp(1.5rem, 3.4vw, 2.125rem);
        font-weight: 700;
        color: var(--fg);
    }
    .feat__body {
        margin: 1rem 0 0;
        font-size: clamp(0.9375rem, 1.6vw, 1.0625rem);
        color: var(--fg-muted);
        max-width: 48ch;
    }

    .feat__groups { display: grid; gap: 1.1rem; margin-top: 1.75rem; }
    .feat__group-label {
        margin: 0 0 0.5rem;
        font-family: var(--font-mono);
        font-size: 0.625rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--fg-subtle);
    }
    .feat__group ul {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin: 0;
        padding: 0;
    }

    /* ---------- Rack visual ---------- */
    .rack {
        border: 1px solid var(--line);
        border-radius: var(--r-md);
        background: var(--bg);
        padding: 0.9rem;
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        overflow: hidden;
    }
    .rack__head {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding-bottom: 0.75rem;
        margin-bottom: 0.5rem;
        border-bottom: 1px solid var(--line);
        color: var(--fg-subtle);
        letter-spacing: 0.05em;
    }
    .rack__led {
        width: 0.4rem;
        height: 0.4rem;
        border-radius: 50%;
        background: var(--accent);
        box-shadow: 0 0 6px var(--accent);
    }
    .rack__row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 3.5rem auto;
        align-items: center;
        gap: 0.6rem;
        padding-block: 0.42rem;
    }
    .rack__svc {
        color: var(--fg-muted);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .rack__bar {
        height: 3px;
        border-radius: var(--r-pill);
        background: var(--line);
        overflow: hidden;
    }
    .rack__bar > span {
        display: block;
        height: 100%;
        border-radius: inherit;
        background: linear-gradient(90deg, var(--v-600), var(--c-400));
        transform-origin: 0 50%;
    }
    .rack__state { color: var(--accent); font-size: 0.5625rem; letter-spacing: 0.08em; }

    /* La barra crece con el scroll (nativo), si no queda en su valor final */
    @supports (animation-timeline: view()) {
        .rack__bar > span {
            scale: 0 1;
            animation: bar-grow linear both;
            animation-timeline: --feat;
            /* cada fila arranca un poco después que la anterior */
            animation-range: cover calc(18% + var(--i, 0) * 3%) cover calc(46% + var(--i, 0) * 3%);
        }
    }
    @keyframes bar-grow { to { scale: 1 1; } }

    /* ---------- Soluciones ---------- */
    .pj__subhead {
        margin: clamp(3rem, 7vw, 4.5rem) 0 1.75rem;
        font-size: clamp(1.25rem, 2.6vw, 1.625rem);
        font-weight: 600;
        color: var(--fg);
    }

    .pj__grid {
        display: grid;
        gap: 1rem;
    }
    @media (min-width: 760px)  { .pj__grid { grid-template-columns: repeat(2, 1fr); } }
    @media (min-width: 1100px) { .pj__grid { grid-template-columns: repeat(3, 1fr); } }

    .sol { display: flex; flex-direction: column; padding: 1.6rem 1.5rem; }
    .sol__icon {
        display: grid;
        place-items: center;
        width: 2.6rem;
        height: 2.6rem;
        border-radius: var(--r-md);
        background: var(--accent-soft);
        color: var(--accent);
        margin-bottom: 1.1rem;
    }
    .sol__icon svg { width: 1.35rem; height: 1.35rem; }
    .sol h4 {
        font-size: 1.0625rem;
        font-weight: 600;
        color: var(--fg);
        margin-bottom: 0.6rem;
    }
    .sol p {
        margin: 0 0 1.25rem;
        font-size: 0.9375rem;
        color: var(--fg-muted);
        flex: 1;
    }
    .sol__tools {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin: 0;
        padding: 0;
    }
    .sol__tools .chip { font-size: 0.75rem; padding: 0.25rem 0.6rem; }

    @media (prefers-reduced-motion: reduce) {
        .dot-live { animation: none; }
        .rack__bar > span { animation: none !important; scale: 1 1 !important; }
    }
</style>
