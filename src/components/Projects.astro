---
import { destacado, proyectos, automatizaciones } from "../data/cv";

const ICONO_LINK = "M14 4h6v6M20 4l-9 9M18 14v4.5a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 4 18.5v-11A1.5 1.5 0 0 1 5.5 6H10";
const ICONO_REPO = "M9 19c-4 1.3-4-2-6-2.5M15 21v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1-.3-3.4 1.3a11.6 11.6 0 0 0-6 0C6.8 2.8 5.8 3.1 5.8 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4.4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21";

// Panel decorativo del destacado: las piezas de Clipmill.
const piezas: [string, string, number][] = [
    ["estudio · :3060", "vista previa", 88],
    ["render · chrome + ffmpeg", "cola", 72],
    ["flujos · guion → voz → render", "auto", 64],
    ["teleprompter", "2.ª pantalla", 41],
    ["edición asistida", "cortes", 57],
    ["biblioteca por canal", "yt / fb", 35],
];
---
<section id="projects" class="section section--alt">
    <div class="shell">
        <header class="pj__head">
            <p class="eyebrow reveal">Trabajo</p>
            <h2 class="section-title reveal" style="--reveal-delay:60ms">Proyectos &amp; automatizaciones</h2>
            <p class="section-lede reveal" style="--reveal-delay:120ms">
                Software que construyo y mantengo: en producción u open source, con link para verlo.
            </p>
        </header>

        <!-- Proyecto destacado -->
        <article class="feat card card--lit reveal">
            <div class="feat__main">
                <p class="feat__kicker">
                    <span class="dot-live" aria-hidden="true"></span>
                    Proyecto principal · open source
                </p>
                <h3 class="feat__title">{destacado.titulo}</h3>
                <p class="feat__body">{destacado.resumen}</p>

                <ul class="feat__points">
                    {destacado.puntos.map((pt) => <li>{pt}</li>)}
                </ul>

                <ul class="feat__stack">
                    {destacado.stack.map((t) => <li class="chip">{t}</li>)}
                </ul>

                {destacado.repo && (
                    <a class="btn btn--ghost feat__cta" href={destacado.repo} target="_blank" rel="noopener noreferrer">
                        Ver en GitHub
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                             stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true">
                            <path d={ICONO_LINK} />
                        </svg>
                    </a>
                )}
            </div>

            <!-- Visual: las piezas de Clipmill -->
            <div class="rack" aria-hidden="true">
                <div class="rack__head">
                    <span class="rack__led"></span>
                    <span class="rack__name">clipmill · estudio</span>
                </div>
                {piezas.map(([name, state, load], i) => (
                    <div class="rack__row" style={`--i:${i}`}>
                        <span class="rack__svc">{name}</span>
                        <span class="rack__bar"><span style={`width:${load}%`}></span></span>
                        <span class="rack__state">{state}</span>
                    </div>
                ))}
            </div>
        </article>

        <h3 class="pj__subhead reveal">En producción y open source</h3>

        <div class="pj__grid pj__grid--many stagger">
            {proyectos.map((p, i) => (
                <article class="sol card card--hover card--lit reveal" style={`--i:${(i % 3) + 1}; --reveal-delay:${(i % 3) * 100}ms`}>
                    <h4>{p.titulo}</h4>
                    <p>{p.resumen}</p>
                    <ul class="sol__tools">
                        {p.stack.map((t) => <li class="chip chip--accent">{t}</li>)}
                    </ul>
                    <div class="sol__links">
                        {p.link && (
                            <a href={p.link.url} target="_blank" rel="noopener noreferrer">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ICONO_LINK} /></svg>
                                {p.link.texto}
                            </a>
                        )}
                        {p.repo && (
                            <a href={p.repo} target="_blank" rel="noopener noreferrer">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ICONO_REPO} /></svg>
                                Código
                            </a>
                        )}
                    </div>
                </article>
            ))}
        </div>

        <h3 class="pj__subhead reveal">IA conversacional e infraestructura</h3>

        <div class="pj__grid stagger">
            {automatizaciones.map((s, i) => (
                <article class="sol card card--hover card--lit reveal" style={`--i:${i + 1}; --reveal-delay:${i * 100}ms`}>
                    <h4>{s.titulo}</h4>
                    <p>{s.resumen}</p>
                    <ul class="sol__tools">
                        {s.stack.map((t) => <li class="chip chip--accent">{t}</li>)}
                    </ul>
                </article>
            ))}
        </div>
    </div>
</section>

<style>
    /* ---------- Destacado: puntos, stack y botón ---------- */
    .feat__points { margin: 1.4rem 0 0; padding-left: 1.1rem; display: grid; gap: 0.45rem; color: var(--fg-muted); font-size: 0.95rem; }
    .feat__points li::marker { color: var(--accent); }
    .feat__stack { list-style: none; display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 1.4rem 0 0; padding: 0; }
    .feat__cta { margin-top: 1.6rem; display: inline-flex; align-items: center; gap: 0.5rem; }
    /* ---------- Enlaces de cada proyecto ---------- */
    .sol__links { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 1.1rem; padding-top: 0.9rem; border-top: 1px solid var(--line); }
    .sol__links:empty { display: none; }
    .sol__links a { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.85rem; font-weight: 600; color: var(--brand-ink); text-decoration: none; }
    .sol__links a:hover { color: var(--accent); }
    .sol__links svg { width: 0.95rem; height: 0.95rem; }
    .sol .sol__tools { margin-top: auto; padding-top: 1rem; }

    .pj__head { max-width: 46rem; margin-bottom: clamp(2.5rem, 6vw, 3.5rem); }

    /* ---------- Portada conceptual ---------- */
    .pj__cover {
        position: relative;
        margin: 0 0 1rem;
        border-radius: var(--r-xl);
        overflow: hidden;
        border: 1px solid var(--line);
        box-shadow: var(--shadow-md);
        transition: border-color var(--dur-base) var(--ease-out),
                    box-shadow var(--dur-base) var(--ease-out);
    }
    .pj__cover:hover,
    .pj__cover:focus-within {
        border-color: var(--line-strong);
        box-shadow: var(--shadow-lg);
    }

    /* Hairline de degradado que enciende el borde superior, igual que .card--lit */
    .pj__cover::before {
        content: "";
        position: absolute;
        inset: -1px -1px auto -1px;
        height: 1px;
        z-index: 2;
        border-radius: inherit;
        background: linear-gradient(90deg, transparent, var(--brand), var(--accent), transparent);
        opacity: 0;
        transition: opacity var(--dur-base) var(--ease-out);
    }
    .pj__cover:hover::before,
    .pj__cover:focus-within::before { opacity: 0.9; }

    .pj__cover img {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 1100 / 629;
        object-fit: cover;
        scale: 1;
        filter: saturate(1);
        transition: scale 900ms var(--ease-out), filter 900ms var(--ease-out);
    }
    .pj__cover:hover img,
    .pj__cover:focus-within img { scale: 1.045; filter: saturate(1.15); }

    .pj__cover figcaption {
        position: absolute;
        inset: auto 0 0 0;
        z-index: 1;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1rem;
        padding: 2.75rem 1.25rem 0.9rem;
        background: linear-gradient(0deg, rgba(8,7,15,.88) 0%, transparent 100%);
        color: #cbd5e1;
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        letter-spacing: 0.04em;
        transition: color var(--dur-base) var(--ease-out);
    }
    .pj__cover:hover figcaption,
    .pj__cover:focus-within figcaption { color: #f1f5f9; }

    .pj__cover-badge {
        flex: none;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.25rem 0.6rem;
        border-radius: var(--r-pill);
        border: 1px solid rgba(255,255,255,.18);
        background: rgba(255,255,255,.08);
        backdrop-filter: blur(6px);
        color: #e9e7f3;
        font-size: 0.625rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        opacity: 0;
        translate: 0 4px;
        transition: opacity var(--dur-base) var(--ease-out), translate var(--dur-base) var(--ease-out);
    }
    .pj__cover-badge svg { width: 0.8rem; height: 0.8rem; }
    .pj__cover:hover .pj__cover-badge,
    .pj__cover:focus-within .pj__cover-badge { opacity: 1; translate: 0 0; }

    /* ---------- Destacado ---------- */
    .feat {
        display: grid;
        gap: clamp(2rem, 4vw, 3rem);
        padding: clamp(1.5rem, 3.5vw, 2.5rem);
        background: linear-gradient(145deg, var(--surface), var(--surface-2));
        view-timeline-name: --feat;
        view-timeline-axis: block;
    }
    @media (min-width: 1000px) {
        .feat { grid-template-columns: 1.15fr 0.85fr; align-items: center; }
    }

    .feat__kicker {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        margin: 0 0 1rem;
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--accent);
    }
    .dot-live {
        width: 0.45rem;
        height: 0.45rem;
        border-radius: 50%;
        background: currentColor;
        animation: pulse-dot 2.4s var(--ease-out) infinite;
    }

    .feat__title {
        font-size: clamp(1.5rem, 3.4vw, 2.125rem);
        font-weight: 700;
        color: var(--fg);
    }
    .feat__body {
        margin: 1rem 0 0;
        font-size: clamp(0.9375rem, 1.6vw, 1.0625rem);
        color: var(--fg-muted);
        max-width: 48ch;
    }

    .feat__groups { display: grid; gap: 1.1rem; margin-top: 1.75rem; }
    .feat__group-label {
        margin: 0 0 0.5rem;
        font-family: var(--font-mono);
        font-size: 0.625rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--fg-subtle);
    }
    .feat__group ul {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin: 0;
        padding: 0;
    }

    /* ---------- Rack visual ---------- */
    .rack {
        border: 1px solid var(--line);
        border-radius: var(--r-md);
        background: var(--bg);
        padding: 0.9rem;
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        overflow: hidden;
    }
    .rack__head {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding-bottom: 0.75rem;
        margin-bottom: 0.5rem;
        border-bottom: 1px solid var(--line);
        color: var(--fg-subtle);
        letter-spacing: 0.05em;
    }
    .rack__led {
        width: 0.4rem;
        height: 0.4rem;
        border-radius: 50%;
        background: var(--accent);
        box-shadow: 0 0 6px var(--accent);
    }
    .rack__row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 3.5rem auto;
        align-items: center;
        gap: 0.6rem;
        padding-block: 0.42rem;
    }
    .rack__svc {
        color: var(--fg-muted);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .rack__bar {
        height: 3px;
        border-radius: var(--r-pill);
        background: var(--line);
        overflow: hidden;
    }
    .rack__bar > span {
        display: block;
        height: 100%;
        border-radius: inherit;
        background: linear-gradient(90deg, var(--v-600), var(--c-400));
        transform-origin: 0 50%;
    }
    .rack__state { color: var(--accent); font-size: 0.5625rem; letter-spacing: 0.08em; }

    /* La barra crece con el scroll (nativo), si no queda en su valor final */
    @supports (animation-timeline: view()) {
        .rack__bar > span {
            scale: 0 1;
            animation: bar-grow linear both;
            animation-timeline: --feat;
            /* cada fila arranca un poco después que la anterior */
            animation-range: cover calc(18% + var(--i, 0) * 3%) cover calc(46% + var(--i, 0) * 3%);
        }
    }
    @keyframes bar-grow { to { scale: 1 1; } }

    /* ---------- Soluciones ---------- */
    .pj__subhead {
        margin: clamp(3rem, 7vw, 4.5rem) 0 1.75rem;
        font-size: clamp(1.25rem, 2.6vw, 1.625rem);
        font-weight: 600;
        color: var(--fg);
    }

    .pj__grid {
        display: grid;
        gap: 1rem;
    }
    @media (min-width: 760px)  { .pj__grid { grid-template-columns: repeat(2, 1fr); } }
    @media (min-width: 1100px) { .pj__grid { grid-template-columns: repeat(3, 1fr); } }

    .sol { display: flex; flex-direction: column; padding: 1.6rem 1.5rem; }
    .sol__icon {
        display: grid;
        place-items: center;
        width: 2.6rem;
        height: 2.6rem;
        border-radius: var(--r-md);
        background: var(--accent-soft);
        color: var(--accent);
        margin-bottom: 1.1rem;
    }
    .sol__icon svg { width: 1.35rem; height: 1.35rem; }
    .sol h4 {
        font-size: 1.0625rem;
        font-weight: 600;
        color: var(--fg);
        margin-bottom: 0.6rem;
    }
    .sol p {
        margin: 0 0 1.25rem;
        font-size: 0.9375rem;
        color: var(--fg-muted);
        flex: 1;
    }
    .sol__tools {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin: 0;
        padding: 0;
    }
    .sol__tools .chip { font-size: 0.75rem; padding: 0.25rem 0.6rem; }

    @media (prefers-reduced-motion: reduce) {
        .dot-live { animation: none; }
        .rack__bar > span { animation: none !important; scale: 1 1 !important; }
    }
</style>
