---

---

<button
    id="theme-toggle"
    class="theme-toggle glass"
    type="button"
    aria-label="Cambiar tema"
    title="Cambiar tema"
>
    <span class="theme-toggle__track" aria-hidden="true">
        <span class="theme-toggle__thumb"></span>
    </span>
    <svg class="theme-toggle__ico theme-toggle__ico--sun" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 3v1.5M12 19.5V21M3 12h1.5M19.5 12H21M5.6 5.6l1.1 1.1M17.3 17.3l1.1 1.1M18.4 5.6l-1.1 1.1M6.7 17.3l-1.1 1.1" />
    </svg>
    <svg class="theme-toggle__ico theme-toggle__ico--moon" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20.4 15.4A8.5 8.5 0 0 1 8.6 3.6a8.5 8.5 0 1 0 11.8 11.8Z" />
    </svg>
</button>

<style>
    .theme-toggle {
        position: fixed;
        top: 1.25rem;
        right: 1.25rem;
        z-index: 70;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        min-height: 2.75rem;
        padding: 0.4rem 0.75rem 0.4rem 0.6rem;
        border-radius: var(--r-pill);
        border: 1px solid var(--line);
        color: var(--fg-muted);
        cursor: pointer;
        transition: color var(--dur-base) var(--ease-out),
                    border-color var(--dur-base) var(--ease-out),
                    transform var(--dur-base) var(--ease-out);
    }
    .theme-toggle:hover {
        color: var(--fg);
        border-color: var(--line-strong);
        transform: translateY(-1px);
    }
    @media (min-width: 900px) { .theme-toggle { top: 1.5rem; right: 1.75rem; } }

    .theme-toggle__track {
        position: relative;
        display: block;
        width: 1.9rem;
        height: 1.05rem;
        border-radius: var(--r-pill);
        background: var(--line-strong);
        flex: none;
    }
    .theme-toggle__thumb {
        position: absolute;
        top: 0.15rem;
        left: 0.15rem;
        width: 0.75rem;
        height: 0.75rem;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--v-600), var(--c-400));
        transition: translate var(--dur-base) var(--ease-out);
    }
    :root[data-theme="light"] .theme-toggle__thumb { translate: 0.85rem 0; }

    .theme-toggle__ico { width: 1.05rem; height: 1.05rem; flex: none; }
    .theme-toggle__ico--sun  { display: none; }
    .theme-toggle__ico--moon { display: block; }
    :root[data-theme="light"] .theme-toggle__ico--sun  { display: block; }
    :root[data-theme="light"] .theme-toggle__ico--moon { display: none; }
</style>

<script>
    const root = document.documentElement;
    const btn = document.getElementById("theme-toggle");

    const apply = (theme: string) => {
        root.setAttribute("data-theme", theme);
        btn?.setAttribute("aria-label", theme === "dark" ? "Activar tema claro" : "Activar tema oscuro");
        try {
            localStorage.setItem("theme", theme);
        } catch {
            /* modo privado: la preferencia no persiste, el tema igual se aplica */
        }
    };

    // El tema inicial ya lo fija el script inline de <head> (evita FOUC).
    apply(root.getAttribute("data-theme") || "dark");

    btn?.addEventListener("click", () => {
        apply(root.getAttribute("data-theme") === "dark" ? "light" : "dark");
    });
</script>
