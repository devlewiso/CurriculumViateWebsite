---
import { CV_PDF as CV_URL, CV_PDF_EN, persona } from "../data/cv";

const channels = [
    {
        label: "Email",
        value: "devlewiso@gmail.com",
        href: "mailto:devlewiso@gmail.com",
        external: false,
        d: "M4 7.5 12 13l8-5.5M5 5.5h14a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-11a1 1 0 0 1 1-1Z",
    },
    {
        label: "LinkedIn",
        value: "linkedin.com/in/devlewiso",
        href: "https://linkedin.com/in/devlewiso",
        external: true,
        d: "M8 10.5v6M8 7.3v.1M12 16.5v-3.4a2.1 2.1 0 0 1 4.2 0v3.4M4.5 4h15a.5.5 0 0 1 .5.5v15a.5.5 0 0 1-.5.5h-15a.5.5 0 0 1-.5-.5v-15a.5.5 0 0 1 .5-.5Z",
    },
    {
        label: "GitHub",
        value: "github.com/devlewiso",
        href: persona.github,
        external: true,
        d: "M9 19c-4 1.3-4-2-6-2.5M15 21v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1-.3-3.4 1.3a11.6 11.6 0 0 0-6 0C6.8 2.8 5.8 3.1 5.8 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4.4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21",
    },
    {
        label: "YouTube",
        value: "@devlewiso",
        href: persona.youtube,
        external: true,
        d: "M3.5 8.2c.1-1.4 1.2-2.5 2.6-2.6C8 5.4 10 5.3 12 5.3s4 .1 5.9.3c1.4.1 2.5 1.2 2.6 2.6.2 2.5.2 5.1 0 7.6-.1 1.4-1.2 2.5-2.6 2.6-1.9.2-3.9.3-5.9.3s-4-.1-5.9-.3c-1.4-.1-2.5-1.2-2.6-2.6-.2-2.5-.2-5.1 0-7.6ZM10 9.3v5.4l4.6-2.7L10 9.3Z",
    },
    {
        label: "Curriculum",
        value: "PDF en español",
        href: CV_URL,
        external: true,
        d: "M12 4v10m0 0-3.5-3.5M12 14l3.5-3.5M5 17.5v1A1.5 1.5 0 0 0 6.5 20h11a1.5 1.5 0 0 0 1.5-1.5v-1",
    },
    {
        label: "Resume",
        value: "PDF in English",
        href: CV_PDF_EN,
        external: true,
        d: "M12 4v10m0 0-3.5-3.5M12 14l3.5-3.5M5 17.5v1A1.5 1.5 0 0 0 6.5 20h11a1.5 1.5 0 0 0 1.5-1.5v-1",
    },
];
---

<section id="contact" class="section section--alt contact">
    <div class="bg-mesh" aria-hidden="true"></div>

    <div class="shell contact__inner">
        <p class="eyebrow reveal">Contacto</p>

        <h2 class="contact__title reveal" style="--reveal-delay:60ms">
            Conversemos sobre<br />
            <span class="contact__title-accent">automatización e IA</span>
        </h2>

        <p class="contact__lede reveal" style="--reveal-delay:120ms">
            Si necesitás analizar un sistema, automatizar un proceso o construir una herramienta
            con IA de punta a punta, hablemos. Respondo en menos de 24 horas.
        </p>

        <div class="contact__cta reveal" style="--reveal-delay:180ms">
            <a href="mailto:devlewiso@gmail.com?subject=Proyecto%20de%20automatizaci%C3%B3n" class="btn btn--primary">
                Enviar un mensaje
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true">
                    <path d="M5 12h13M13 6l6 6-6 6" />
                </svg>
            </a>
            <a href={CV_URL} target="_blank" rel="noopener noreferrer" class="btn btn--ghost">Ver CV completo</a>
        </div>

        <ul class="channels stagger">
            {channels.map((c, i) => (
                <li class="reveal" style={`--i:${i}; --reveal-delay:${i * 90}ms`}>
                    <a
                        href={c.href}
                        class="channel card card--hover card--lit"
                        target={c.external ? "_blank" : undefined}
                        rel={c.external ? "noopener noreferrer" : undefined}
                    >
                        <span class="channel__icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
                                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d={c.d} />
                            </svg>
                        </span>
                        <span class="channel__text">
                            <span class="channel__label">{c.label}</span>
                            <span class="channel__value">{c.value}</span>
                        </span>
                        <svg class="channel__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M6 18 18 6M9 6h9v9" />
                        </svg>
                    </a>
                </li>
            ))}
        </ul>
    </div>
</section>

<style>
    .contact {
        position: relative;
        overflow: hidden;
        text-align: center;
    }
    .contact__inner { position: relative; z-index: 1; max-width: 52rem; }
    .contact .eyebrow { justify-content: center; }
    .contact .eyebrow::after {
        content: "";
        width: 1.75rem;
        height: 1px;
        background: currentColor;
        opacity: 0.6;
    }

    .contact__title {
        font-size: clamp(2rem, 5.5vw, 3.5rem);
        font-weight: 700;
        color: var(--fg);
    }
    .contact__title-accent {
        background: linear-gradient(100deg, var(--grad-a), var(--grad-b));
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .contact__lede {
        margin: 1.5rem auto 0;
        max-width: 46ch;
        font-size: clamp(1rem, 1.8vw, 1.125rem);
        color: var(--fg-muted);
    }

    .contact__cta {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.875rem;
        margin-top: 2.25rem;
    }

    .channels {
        list-style: none;
        display: grid;
        gap: 0.75rem;
        margin: clamp(3rem, 7vw, 4rem) 0 0;
        padding: 0;
        text-align: left;
    }
    @media (min-width: 640px) { .channels { grid-template-columns: repeat(2, 1fr); } }
    @media (min-width: 900px) { .channels { grid-template-columns: repeat(3, 1fr); } }

    .channel {
        display: flex;
        align-items: center;
        gap: 0.9rem;
        padding: 1.05rem 1.15rem;
        text-decoration: none;
        height: 100%;
    }
    .channel__icon {
        display: grid;
        place-items: center;
        width: 2.35rem;
        height: 2.35rem;
        border-radius: var(--r-md);
        background: var(--brand-soft);
        color: var(--brand-ink);
        flex: none;
        transition: background var(--dur-base) var(--ease-out),
                    color var(--dur-base) var(--ease-out);
    }
    .channel__icon svg { width: 1.2rem; height: 1.2rem; }
    .channel:hover .channel__icon { background: var(--accent-soft); color: var(--accent); }

    .channel__text { display: grid; gap: 0.1rem; min-width: 0; flex: 1; }
    .channel__label {
        font-family: var(--font-mono);
        font-size: 0.625rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--fg-subtle);
    }
    .channel__value {
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--fg);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .channel__arrow {
        width: 0.95rem;
        height: 0.95rem;
        color: var(--fg-subtle);
        flex: none;
        transition: color var(--dur-base) var(--ease-out),
                    transform var(--dur-base) var(--ease-out);
    }
    .channel:hover .channel__arrow {
        color: var(--accent);
        transform: translate(2px, -2px);
    }
</style>
